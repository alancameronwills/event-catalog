# Force npm to fetch Lambda-compatible (Linux x64 glibc) native binaries for
# sharp, regardless of the OS this is built on — Lambda always runs on Amazon
# Linux even when `sam build` is invoked from Windows/macOS. Without this,
# `sam build` would install the host platform's sharp binary and the deployed
# function would fail at import time.
os=linux
cpu=x64
libc=glibc
