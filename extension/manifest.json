{
  "manifest_version": 3,
  "name": "Event Poster Catalog",
  "version": "0.1.0",
  "description": "Assisted capture of event posters from any web page into a local, date-organized catalog with duplicate detection.",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Event Catalog"
  },
  "commands": {
    "capture-hovered-image": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Capture the image under the cursor to the event catalog"
    }
  }
}
